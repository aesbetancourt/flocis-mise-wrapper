# Emulator state and upgrade backups
floci-lab/data/
floci-lab/backups/
floci-lab/.data-restore/

# Throwaway files from CLI experiments. It is inside the lab, so the lab environment applies.
floci-lab/scratch/

# OpenTofu, at any depth (floci-lab/ and exercise folders). Keep .terraform.lock.hcl tracked.
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Local overrides
.env.local
.DS_Store

# Exercise lock files. The root floci-lab/.terraform.lock.hcl pins the providers.
floci-lab/exercises/**/.terraform.lock.hcl

# Lambda zip files that archive_file writes during an exercise
floci-lab/exercises/**/build/
__pycache__/

# Python formatter cache
.ruff_cache/
